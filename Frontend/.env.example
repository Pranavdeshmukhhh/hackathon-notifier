# Development stays local. Point only at an isolated API while testing the UI.
# Accepts the server root, /api, /api/v1, or the full hackathons endpoint.
VITE_API_URL=http://localhost:8000

# For a production Vercel build, set VITE_API_URL in project environment settings
# to https://hackathon-notifier.onrender.com (the built-in production default).
# Environment changes require a new build; never put secrets in VITE_ variables.
