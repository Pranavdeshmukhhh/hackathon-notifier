# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Telegram Bot — get token from @BotFather, get chat ID from getUpdates API
TELEGRAM_BOT_TOKEN=<your-bot-token>
TELEGRAM_CHAT_ID=<your-chat-id>

# Optional: Frontend URL for CORS and Telegram bot links
# FRONTEND_URL=https://hackathon-notifier.vercel.app
# WEBAPP_URL=https://hackathon-notifier.vercel.app

# Optional: Admin secret for cache refresh endpoint
# ADMIN_SECRET=<random-secret>

# Optional: Cache TTL in seconds (default 10800 = 3 hours)
# CACHE_TTL_SECONDS=10800
