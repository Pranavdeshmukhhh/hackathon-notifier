# =============================================================================
# Hackathon Notifier — Environment Variables
# =============================================================================
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in each value below with your real credentials.
#   3. Never commit the filled-in .env file — it is in .gitignore.
#
# =============================================================================


# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string.
# How to get it: Atlas dashboard → Your Cluster → Connect → Drivers → Python
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>
MONGO_DB_NAME=hackathon_tracker

# Telegram bot token — get one from @BotFather on Telegram (/newbot command)
TELEGRAM_BOT_TOKEN=<your-bot-token>

# Your Telegram chat ID — this is used for admin commands (/scrape_now, /broadcast)
# and as the default push notification target.
# How to get it: Send a message to your bot, then visit:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   Look for "chat": {"id": ...} in the response.
TELEGRAM_CHAT_ID=<your-chat-id>


# ── Optional ─────────────────────────────────────────────────────────────────

# Frontend URL — used in Telegram bot "Open App" buttons and CORS allow-list.
# Default: https://hackathon-notifier.vercel.app
# WEBAPP_URL=https://hackathon-notifier.vercel.app
# FRONTEND_URL=https://hackathon-notifier.vercel.app,http://localhost:5173

# Admin secret — protects all administrative POST endpoints.
# Set this to any long random string. Used in the X-Admin-Secret request header.
# ADMIN_SECRET=<random-secret-string>

# Telegram API base URL — only change if using a local Telegram Bot API reverse proxy.
# Default: https://api.telegram.org
# TELEGRAM_API_BASE=https://api.telegram.org

# Cache TTL in seconds — how long API responses are cached in memory.
# Default/max: 60 seconds; shared generation polled every 5 seconds.
CACHE_TTL_SECONDS=60

# Port — overridden automatically by Render. Only change for local testing.
# Default: 10000
# PORT=10000

# Environment — set to "production" to disable Swagger UI (/docs, /redoc).
# ENVIRONMENT=production

# Explicit opt-ins; leave off for local tests and staging.
ENABLE_BACKGROUND_SCANNER=false
SCAN_INTERVAL_MINUTES=30
TRACK_VISITORS=false

# Phase 5: enable only after the restored-clone migration and replica-set checks.
# Production writes fail closed without transactions; public reads remain available.
PHASE5_WRITE_TRANSACTIONS=false
ENABLE_NOTIFICATION_DELIVERY=false
ENABLE_TELEGRAM_POLLING=false
ENABLE_GEOCODING=false
# Use a real operator contact when enabling the Nominatim geocoder.
# GEOCODER_USER_AGENT=HackathonNotifier/1.0 (contact: your-email@example.com)

# Trust only the actual reverse-proxy peer ranges. Empty means ignore forwarded IP headers.
TRUSTED_PROXY_CIDRS=
TRUST_CLOUDFLARE_HEADERS=false

# Separate staging MongoDB deployment for isolated recovery drills (never production).
# STAGING_MONGO_URI=mongodb://127.0.0.1:27017
