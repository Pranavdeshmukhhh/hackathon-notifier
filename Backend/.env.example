# Local setup only. Keep real credentials out of git and VITE_ variables.
MONGO_URI=mongodb://127.0.0.1:27017
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_SECRET=
FRONTEND_URL=http://localhost:5173
WEBAPP_URL=http://localhost:5173
PORT=8000
ENVIRONMENT=development
ENABLE_BACKGROUND_SCANNER=false
TRACK_VISITORS=false
SCAN_INTERVAL_MINUTES=30
TRUSTED_PROXY_CIDRS=
TRUST_CLOUDFLARE_HEADERS=false
SOURCE_WORKERS=4
SOURCE_TIMEOUT_SECONDS=60
SOURCE_BUDGET_SECONDS=240
SOURCE_ATTEMPTS=2
# Production: set your own Mongo URI, HTTPS origins, secret and ENVIRONMENT=production.
# ADMIN_SECRET unset disables administrator endpoints.
# A Telegram token enables polling in unified_server.py; leave blank for API-only use.
# Large catalogs need explicit publication: docs/INDEXED_API_PERFORMANCE.md.
# Optional restore target; must be empty and named phase0_restore_...:
# STAGING_MONGO_URI=
